{
  "name": "FlameAtlas Research Platform",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "features": { "ghcr.io/devcontainers/features/node:1": { "version": "22" } },
  "forwardPorts": [3000],
  "portsAttributes": {
    "3000": { "label": "FlameAtlas Research Platform", "onAutoForward": "openBrowser" },
    "8000": { "label": "Internal research API", "onAutoForward": "ignore" }
  },
  "postCreateCommand": "python scripts/research_platform.py setup",
  "postStartCommand": "python scripts/research_platform.py start --background --host 0.0.0.0",
  "waitFor": "postCreateCommand"
}
