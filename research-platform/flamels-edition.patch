+def test_graph_never_exposes_an_unresolved_document_id(conn):
+    refs = [row[0] for row in conn.execute("SELECT DISTINCT source_ref FROM kg_edges")]
+    assert refs
+    assert not any(ref.startswith("None") for ref in refs)
+    for ref in refs:
+        if "#page=" in ref:
+            document_id = ref.split("#", 1)[0]
+            local = conn.execute("SELECT 1 FROM documents WHERE document_id=?", (document_id,)).fetchone()
+            assert local or any(slugify(path) == document_id for path in CATALOG)
+
+
+def test_missing_declared_report_has_a_useful_source_availability_page(client, conn):
+    missing = [(path, meta) for path, meta in CATALOG.items()
+               if path.endswith(".pdf") and not conn.execute(
+                   "SELECT 1 FROM documents WHERE document_id=?", (slugify(path),)).fetchone()]
+    for path, meta in missing:
+        response = client.get(f"/api/v1/documents/{slugify(path)}/file")
+        assert response.status_code == 424
+        assert "Document not included in this checkout" in response.text
+        assert f"https://psi.nasa.gov/physci/repo/data/investigations/{meta['inv']}" in response.text
+        assert "not been indexed or read" in response.text
+    assert client.get("/api/v1/documents/unknown-untrusted-id/file").status_code == 404
