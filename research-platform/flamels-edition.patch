+import type { Metadata } from "next";
+import Link from "next/link";
+import { BRAND } from "@/lib/brand";
+
+export const metadata: Metadata = { title: "About The Flamels" };
+
+export default function AboutPage() {
+  return (
+    <article className="mx-auto max-w-4xl px-5 py-14 md:px-8">
+      <p className="text-xs uppercase tracking-[.22em] text-data">The Flamels / Research platform</p>
+      <h1 className="display mt-4 text-4xl md:text-6xl">Evidence before interpretation.</h1>
+      <p className="mt-6 max-w-3xl text-lg leading-relaxed text-text-2">FlameAtlas brings microgravity combustion research into a dedicated workspace for The Flamels. Explore each investigation at the level its source files support, inspect provenance, and keep conceptual demonstrations separate from experimental observations.</p>
+      <div className="mt-8 flex flex-wrap gap-3">
+        <Link href="/demo" className="rounded-lg bg-flame px-5 py-3 font-medium text-flame-ink">Start guided demo</Link>
+        <a href={BRAND.repository} className="rounded-lg border border-line-strong px-5 py-3">View The Flamels on GitHub ↗</a>
+        <a href={BRAND.presentation} className="rounded-lg border border-line-strong px-5 py-3">Open evidence presentation ↗</a>
+      </div>
+      <section className="mt-12 rounded-xl border border-line bg-panel p-6">
+        <h2 className="text-xl font-semibold">Source and software provenance</h2>
+        <p className="mt-4 leading-relaxed text-text-2">This edition adapts <a className="underline" href={BRAND.upstream}>SpaceFire-AI by COngtuthien</a>. The original implementation, scientific processing methods and source credits remain attributed to that project. The Flamels edition adds its own identity, navigation, installation workflow and integration with the existing FlameAtlas evidence workspace.</p>
+        <p className="mt-4 break-all font-mono text-xs text-text-3">Reference source commit: {BRAND.upstreamCommit}</p>
+        <p className="mt-4 text-sm leading-relaxed text-text-3">The upstream repository supplies no license file. This edition does not assign a new license to upstream materials. NASA measurements, documents and media retain their individual source attribution and usage notes.</p>
+      </section>
+      <section className="mt-8">
+        <h2 className="text-xl font-semibold">Read the evidence correctly</h2>
+        <ul className="mt-4 list-disc space-y-3 pl-5 leading-relaxed text-text-2">
+          <li>Counts describe imported records and collections, not interchangeable experiments or scientific confidence.</li>
+          <li>Three-dimensional studios are conceptual educational illustrations. Their animation time is not an observed experimental timeline.</li>
+          <li>Research relevance and condition similarity are distinct from fire hazard.</li>
+          <li>Model-written answers require your own server-side provider key. With no key, the Copilot retrieves evidence without inventing an AI answer.</li>
+          <li>The exploratory estimator and its reported validation limits remain separate from measured NASA outcomes.</li>
+        </ul>
+        <p className="mt-8 text-sm text-text-3">Independent research support tool. Not affiliated with NASA and not a certified fire safety assessment.</p>
+      </section>
+    </article>
+  );
+}
